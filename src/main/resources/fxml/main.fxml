<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="media.controller.MainController"
      stylesheets="@../css/style.css"
      spacing="0">

    <!-- Панель действий -->
    <HBox styleClass="toolbar-panel" spacing="10">
        <Button fx:id="addBtn" text="Добавить"/>
        <Button fx:id="editBtn" text="Редактировать"/>
        <Button fx:id="deleteBtn" text="Удалить" styleClass="danger-button"/>
        <Button fx:id="refreshBtn" text="Обновить"/>
        <Button fx:id="statsBtn" text="Статистика"/>
        <Button fx:id="exportBtn" text="Экспорт"/>
    </HBox>

    <!-- Панель фильтров -->
    <HBox styleClass="filter-panel" spacing="10">
        <Label text="Поиск:"/>
        <TextField fx:id="searchField" prefWidth="300"
                   promptText="Поиск по названию, тексту, категории..."/>
        <Label text="Статус:"/>
        <ComboBox fx:id="statusFilterCombo" prefWidth="150"/>
        <Label text="Категория:"/>
        <ComboBox fx:id="categoryFilterCombo" prefWidth="150"/>
        <Button fx:id="resetBtn" text="Сбросить" styleClass="reset-button"/>
    </HBox>

    <!-- Таблица -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
